<Window x:Class="NOR.Views.VideoTrimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim Wallpaper - NŌR Studio"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#12151B"
        Foreground="#ECEFF4"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="✂️ Precision Video Loop Trimmer" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="Select start and end markers for seamless loop transition." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Preview Player -->
        <Border Grid.Row="1" Background="#0A0C10" CornerRadius="8" BorderBrush="#262A34" BorderThickness="1" ClipToBounds="True">
            <MediaElement x:Name="TrimPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          MediaEnded="TrimPlayer_MediaEnded" />
        </Border>

        <!-- Slider Controls -->
        <StackPanel Grid.Row="2" Margin="0,16,0,16">
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="TxtStartTime" Text="Start: 0:00" Foreground="#60A5FA" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <TextBlock x:Name="TxtEndTime" Text="End: 0:15" Foreground="#60A5FA" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="Start Marker" FontSize="11" Foreground="#94A3B8" />
            <Slider x:Name="SliderStart" Minimum="0" Value="0" Margin="0,2,0,8" ValueChanged="SliderStart_ValueChanged" />

            <TextBlock Text="End Marker" FontSize="11" Foreground="#94A3B8" />
            <Slider x:Name="SliderEnd" Minimum="0" Value="10" Margin="0,2,0,0" ValueChanged="SliderEnd_ValueChanged" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Play Segment" Width="110" Height="34" Click="BtnPlaySegment_Click"
                    Background="#1E232E" Foreground="#F8FAFC" BorderBrush="#333846" />
            <Button Content="Save &amp; Apply" Width="110" Height="34" Click="BtnSave_Click"
                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>

