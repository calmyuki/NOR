<Window x:Class="NOR.Views.VideoCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Aspect Ratio - NŌR Studio"
        Width="580" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="#12151B"
        Foreground="#ECEFF4"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📐 Aspect Ratio &amp; Display Scaling" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="Select target display proportion for automatic zero-distortion fit." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Presets -->
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center">
            <RadioButton x:Name="Rb16x9" Content="16:9 Widescreen (1080p, 1440p, 4K UHD)" IsChecked="True" Foreground="#E2E8F0" FontSize="13" />
            <RadioButton x:Name="Rb16x10" Content="16:10 Laptop &amp; Productivity (1920×1200, 2560×1600)" Foreground="#E2E8F0" FontSize="13" />
            <RadioButton x:Name="Rb21x9" Content="21:9 Ultrawide Gaming Monitor (2560×1080, 3440×1440)" Foreground="#E2E8F0" FontSize="13" />
            <RadioButton x:Name="RbFill" Content="Uniform-To-Fill (Stretch to fit display boundary without black bars)" Foreground="#E2E8F0" FontSize="13" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Cancel" Width="90" Height="34" Click="BtnCancel_Click"
                    Background="#1E232E" Foreground="#F8FAFC" BorderBrush="#333846" />
            <Button Content="Apply Preset" Width="110" Height="34" Click="BtnApply_Click"
                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>

